<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenSlate</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>OpenSlate si collega al tuo Bamboo Slate via Bluetooth. / OpenSlate connects to your Bamboo Slate over Bluetooth.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_openslate-sync._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Per inquadrare i QR della desktop (impostazioni AI, sincronizzazione). / To scan the desktop app's QR codes (AI settings, sync).</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Per sincronizzarti col tuo computer e usare la sua AI (LM Studio, Ollama). / To sync with your computer and use its AI (LM Studio, Ollama).</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Per dettare i messaggi alla chat AI, solo quando tocchi il microfono. / To dictate messages to the AI chat, only when you tap the microphone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Per trasformare in testo i messaggi che detti alla chat AI (sul telefono, quando la lingua lo permette). / To turn the messages you dictate to the AI chat into text (on the device when the language allows it).</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
</dict>
</plist>
